# "demo" = in-browser mock API backed by localStorage (default, used on GitHub Pages)
# "http" = the real Fastify API at NEXT_PUBLIC_API_URL
NEXT_PUBLIC_API_MODE=demo
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Base path for static hosting under a sub-path, e.g. /flowdesk-crm on GitHub Pages
NEXT_PUBLIC_BASE_PATH=
