{
  "name": "@flowdesk/server",
  "version": "1.0.0",
  "private": true,
  "description": "FlowDesk REST API: Fastify + Prisma + PostgreSQL (SQLite for dev/tests).",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "npm run db:generate:sqlite --silent && tsc --noEmit",
    "test": "npm run db:generate:sqlite --silent && vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:generate:sqlite": "node scripts/sqlite-schema.mjs && prisma generate --schema prisma/sqlite/schema.prisma",
    "db:push:sqlite": "prisma db push --schema prisma/sqlite/schema.prisma --skip-generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx src/db/seed-cli.ts",
    "db:setup:sqlite": "npm run db:generate:sqlite && npm run db:push:sqlite && npm run db:seed",
    "openapi": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@flowdesk/shared": "1.0.0",
    "@prisma/client": "6.19.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.12",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.1.3",
    "prisma": "6.19.3",
    "supertest": "^7.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
