# Copy to .env for local development.
NODE_ENV=development
PORT=4000
# SQLite for local dev (path is relative to prisma/sqlite/). Use a postgresql:// URL with `npm run db:generate`.
DATABASE_URL="file:./dev.db"
# openssl rand -base64 48
JWT_ACCESS_SECRET="dev-only-secret-change-me-please-0123456789abcdef"
JWT_ACCESS_TTL=900
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGIN="http://localhost:3000"
LOG_LEVEL=info
RATE_LIMIT_MAX=300
RATE_LIMIT_LOGIN_MAX=10
# Leave false unless a reverse proxy sits in front of the API; then set its address or CIDR
# (e.g. 127.0.0.1 or 10.0.0.0/8, comma-separated), or true to trust any sender.
# A hop count such as 1 is refused.
TRUST_PROXY=false
SEED_ON_START=false
